.glass-lab{background:transparent;color:#183b49;isolation:isolate;min-height:100vh}.glass-lab > .liquid-wall{height:100vh;inset:0;pointer-events:none;position:fixed;width:100vw;z-index:-1}.glass-lab > .liquid-wall image{height:100%;width:100%}.glass-texture-probe{background:hsla(0,0%,100%,.133);border:2rpx solid hsla(0,0%,100%,.69);border-radius:56rpx;height:236rpx;margin:40rpx 44rpx;position:relative}.glass-texture-copy{color:#153847;display:flex;flex-direction:column;font-size:36rpx;gap:20rpx;height:100%;justify-content:center;padding:0 48rpx;position:relative;z-index:1}.glass-lab-intro{font-size:32rpx;font-weight:600;padding:32rpx 44rpx}.glass-lab-controls{display:flex;gap:24rpx;padding:32rpx 44rpx}.glass-lab-control{background:#f2faf7;border:2rpx solid #90b5c1;border-radius:32rpx;flex:1;font-size:26rpx;padding:28rpx 16rpx;text-align:center}.glass-lab-stage{height:920rpx;overflow:hidden;position:relative;width:100%;z-index:0}.glass-lab-canvas{height:920rpx;left:0;position:absolute;top:0;width:100%;z-index:-1}.glass-lab-heading{background:transparent;color:#183b49;font-size:46rpx;font-weight:600;left:52rpx;position:absolute;top:76rpx}.glass-lab-hint{background:transparent;color:#345c6c;font-size:24rpx;left:52rpx;position:absolute;top:166rpx}.glass-lab-card{background:transparent;box-sizing:border-box;display:flex;flex-direction:column;height:236rpx;justify-content:center;left:44rpx;padding:0 48rpx;position:absolute;right:44rpx;top:302rpx}.glass-lab-title{background:transparent;color:#153847;font-size:38rpx;font-weight:600;margin-bottom:24rpx}.glass-lab-copy{background:transparent;color:#264d60;font-size:24rpx}.glass-lab-toggle{background:#eaf8f3;border-radius:50rpx;color:#234f62;font-size:28rpx;left:140rpx;padding:32rpx;position:absolute;right:140rpx;text-align:center;top:640rpx}.glass-lab-note{display:block;font-size:26rpx;line-height:1.8;padding:48rpx}.glass-lab-card,.glass-lab-heading,.glass-lab-hint,.glass-lab-toggle{z-index:10}