.mp-profile-editor{position:relative}.mp-edit-identity{align-items:center;box-sizing:border-box;display:flex;gap:28rpx;min-height:220rpx;padding:38rpx}.mp-edit-avatar-button{align-items:center;background:#5c5e62;border-radius:50%;color:#fff;display:flex;flex:0 0 144rpx;font-size:36rpx;height:144rpx;justify-content:center;margin:0;overflow:visible;padding:0;position:relative;width:144rpx}.mp-edit-avatar-button::after{border:0}.mp-edit-avatar-image{border-radius:50%;height:144rpx;width:144rpx}.mp-edit-camera{align-items:center;background:#2cb576;border-radius:50%;bottom:0;display:flex;height:40rpx;justify-content:center;position:absolute;right:0;width:40rpx}.mp-edit-form{margin-top:20rpx;padding:38rpx}.mp-edit-field{margin-bottom:32rpx}.mp-edit-label{display:block;font-size:26rpx;font-weight:600}.mp-edit-required{color:#ff5656}.mp-edit-form .mp-input{background:transparent;border-radius:22rpx;height:60rpx;margin-top:18rpx;min-height:60rpx}.mp-edit-form .mp-edit-bio{height:168rpx;padding:16rpx 18rpx}.mp-edit-count{color:#89929d;display:block;font-size:23rpx;margin-top:6rpx;text-align:right}.mp-edit-save{border-radius:24rpx}